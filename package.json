{
  "name": "cpm-enterprise-project-controls",
  "private": true,
  "version": "1.0.0-rc.3",
  "type": "module",
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "audit:dependencies": "npm audit --audit-level=high",
    "sbom": "mkdir -p artifacts && npm sbom --sbom-format cyclonedx > artifacts/sbom.cdx.json",
    "check": "npm run test && npm run build",
    "qualify": "npm run check && npm run audit:dependencies && npm run sbom && npm run test:e2e"
  },
  "dependencies": {
    "dexie": "4.4.3",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.11.1",
    "@playwright/test": "1.58.2",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.4",
    "jsdom": "28.0.0",
    "typescript": "5.9.3",
    "vite": "7.3.1",
    "vite-plugin-pwa": "1.2.0",
    "vitest": "4.0.18"
  }
}
